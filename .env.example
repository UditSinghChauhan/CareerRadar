# ============================================================================
# CareerRadar — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# All variables marked [REQUIRED] must be set for the app to run.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection URI
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL=postgresql://user:password@localhost:5432/careerradar

# [OPTIONAL] How long a connection attempt may hang, in milliseconds.
# node-postgres waits forever by default, so an unreachable database looks like
# a hang and ends ~127 seconds later in a bare ETIMEDOUT. 30s is well above a
# Neon cold start and well below that. Set 0 to restore the wait-forever
# behaviour.
DATABASE_CONNECT_TIMEOUT_MS=30000

# ─── Clerk Authentication ────────────────────────────────────────────────────
# [REQUIRED] Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ─── Server ──────────────────────────────────────────────────────────────────
# [OPTIONAL] Server port (default: 8080)
PORT=8080
# [OPTIONAL] Node environment
NODE_ENV=development
# [OPTIONAL] Base path for the application (default: /)
BASE_PATH=/
# [OPTIONAL] Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── AI Matching (Gemini) ────────────────────────────────────────────────────
# [OPTIONAL] Free API key from https://aistudio.google.com/apikey
# Enables AI-powered resume ↔ job matching scores
# If not set, AI features gracefully degrade (hidden in UI)
GEMINI_API_KEY=

# ─── Job Provider APIs ───────────────────────────────────────────────────────
# [OPTIONAL] Adzuna API credentials — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# [OPTIONAL] RapidAPI JSearch key — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# ─── Aggregator request budgets (Phase 5.5) ──────────────────────────────────
# Both aggregators now run 8 queries with pagination instead of 1 query. These
# cap how many HTTP requests ONE provider run may spend, so a re-triggered sync
# cannot burn a metered quota. Hitting the cap is not an error: the run stops
# cleanly and keeps everything already fetched, and is still logged as a
# success. A partial run cannot mis-close jobs — every budgeted provider is an
# aggregator, and the last-seen sweep never runs against those.

# [OPTIONAL] JSearch requests per run (default: 6). Free tier is 200 per MONTH.
# Measured 2026-09-14: ~8.7 unique postings per request, no yield drop-off
# through page 5. The limit is the month, not the depth. Set to 0 to park it.
JSEARCH_MAX_REQUESTS=6

# [OPTIONAL] Minimum hours between JSearch runs (default: 24). This is the
# setting that keeps JSearch inside its allowance, NOT the per-run budget:
# the cron fires 4x/day, so running every time costs 1,946 req/month against a
# 200 allowance and exhausts the month in 3.1 days. At 6 requests once a day the
# cost is ~182/month. Runs rotate through the query list so all 8 queries are
# covered every ~3 days. Set to 0 to disable the gate (paid tier, or local
# debugging — expect to burn quota).
JSEARCH_MIN_INTERVAL_HOURS=24

# [OPTIONAL] Adzuna requests per run (default: 40). Free tier is 250/DAY, which
# at a 6-hourly cron is ~61 requests per run affordable — Adzuna is not the
# scarce one. The configured query set uses ~23. Short single-word terms only:
# Adzuna AND-matches every word, so long phrases match almost nothing.
ADZUNA_MAX_REQUESTS=40

# [OPTIONAL] Arbeitnow pages per run (default: 4). Free, no key; the provider
# ships disabled — see the note in providers/config.ts.
ARBEITNOW_MAX_REQUESTS=4

# ─── Sync Engine ─────────────────────────────────────────────────────────────
# [REQUIRED in production] Shared secret for the external cron trigger.
# POST /api/sync/cron compares the x-cron-secret header against this value in
# constant time. It deliberately bypasses Clerk — a GitHub Actions runner has no
# browser session cookie. If this is unset the route returns 401 for every
# caller, so sync simply never fires rather than being publicly triggerable.
# Generate one with: openssl rand -hex 32
# Must match the SYNC_CRON_SECRET repo secret used by .github/workflows/sync.yml.
SYNC_CRON_SECRET=

# [OPTIONAL] Master switch for background job sync (default: false)
PROVIDER_ENABLED=false
# [OPTIONAL] Sync interval in milliseconds (default: 21600000 = 6 hours)
PROVIDER_INTERVAL_MS=21600000
# [OPTIONAL] Max concurrent provider syncs (default: 3)
PROVIDER_CONCURRENCY=3
# [OPTIONAL] Run sync immediately on server start (default: false)
PROVIDER_RUN_ON_START=false
# [OPTIONAL] Aggregator postings older than this many days are auto-closed
# (default: 45). Applies to remoteok / remotive / adzuna / jsearch only —
# ATS providers use the last-seen sweep instead. Jobs whose deadline has
# passed are closed on every platform regardless of this value.
SYNC_MAX_AGE_DAYS=45
